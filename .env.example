# === 필수: 텔레그램 봇 설정 ===
# @BotFather 에서 봇 생성 후 발급받은 토큰
TELEGRAM_BOT_TOKEN=123456789:ABCDEF_your_bot_token_here
# @userinfobot 또는 getUpdates 로 확인한 본인 chat_id (또는 채널/그룹 ID)
TELEGRAM_CHAT_ID=123456789

# === 선택: LLM 한국어 요약 & 찐할인 AI 검증 ===
# 설정하지 않으면 규칙 기반 + 커뮤니티/역대가 시그널 엔진만으로도 완벽하게 동작합니다.
# Gemini (무료 티어 지원): https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# 또는 OpenAI 호환 API 사용 시
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# === 선택: 환율 수동 지정 (비워두면 실시간 USD->KRW 자동 조회) ===
USD_KRW_RATE=
