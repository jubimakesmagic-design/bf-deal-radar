# ⚠️ 이 파일은 템플릿입니다. 실제 키를 이 파일에 적지 말고 `.env`로 복사해 사용하세요.
# `.env` 파일은 `.gitignore`에 포함되어 있어 Git에 절대 커밋되지 않습니다.

# === 필수: 텔레그램 봇 설정 ===
# @BotFather 에서 봇 생성 후 발급받은 토큰
TELEGRAM_BOT_TOKEN=<YOUR_TELEGRAM_BOT_TOKEN>
# @userinfobot 에서 확인한 본인 숫자 ID (또는 채널/그룹 ID)
TELEGRAM_CHAT_ID=<YOUR_TELEGRAM_CHAT_ID>

# === 선택: LLM 한국어 요약 & 찐할인 AI 검증 ===
# 설정하지 않으면 규칙 기반 + 커뮤니티/역대가 시그널 엔진만으로도 완벽하게 동작합니다.
# Gemini (무료 티어 지원): https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# 또는 OpenAI 호환 API 사용 시 (원격 서버는 반드시 https:// 사용)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# === 선택: 네이버 쇼핑 검색 API (국내 실시간 시세 기준가 비교 · 무료 일 25,000건) ===
# 발급: https://developers.naver.com/apps/#/register (사용 API: 검색 > 쇼핑)
# 설정하지 않아도 내부 60일 KRW 시세 누적 기반 급락 감지는 자동으로 동작합니다.
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# === 선택: 환율 수동 지정 (비워두면 실시간 USD->KRW 자동 조회) ===
USD_KRW_RATE=
